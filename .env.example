APP_NAME="Switch & Save"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Security review 7.3 (config/security.php, config/trustedproxy.php). Cookies are HTTPS-only in production or when
# APP_URL is https; set SESSION_SECURE_COOKIE to override. TRUSTED_PROXIES: empty = none, IPs/CIDRs, "cloudflare" or "*".
# SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=
CSP_ENABLED=true
CSP_REPORT_ONLY=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
IMPERSONATION_MINUTES=60

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_MARKDOWN_THEME=switch-save

# Switch & Save business details used in emails (config/sspos.php)
SSPOS_SUPPORT_EMAIL=support@switchandsave.co.uk
SSPOS_SUPPORT_PHONE=
SSPOS_STAFF_EMAIL=
# New lead alerts, comma-separated (empty = SSPOS_STAFF_EMAIL)
SSPOS_LEAD_ALERT_EMAILS=
SSPOS_EPOS_DOWNLOAD_URL=https://switchandsave.co.uk/download
SSPOS_PORTAL_URL="${APP_URL}"
SSPOS_EMAIL_LOG_RETENTION_MONTHS=12

# Public trial form (module 1.10): website origins allowed to post (comma-separated) and Cloudflare Turnstile keys.
# Without TURNSTILE_SECRET the captcha is skipped in local/testing only; production refuses requests.
PUBLIC_FORM_ORIGINS=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI (module 6.1, see docs/ai.md). Empty key = AI features report "not set up yet".
ANTHROPIC_API_KEY=
AI_ENABLED=true
AI_MODEL=claude-sonnet-5
AI_FAST_MODEL=claude-haiku-4-5-20251001
# Morning summary model tier (module 6.3): fast (AI_FAST_MODEL) or default (AI_MODEL).
AI_MORNING_SUMMARY_TIER=fast
AI_MONTHLY_TOKENS=2000000
AI_USD_TO_GBP=0.79

# Billing (modules 1.8, 1.13, see config/billing.php): the seller on invoices, VAT and the bank for transfers.
BILLING_SELLER_NAME="Switch & Save"
BILLING_SELLER_LEGAL_NAME="Switch & Save Ltd"
BILLING_SELLER_ADDRESS=
BILLING_SELLER_COMPANY_NUMBER=
BILLING_SELLER_EMAIL=
BILLING_SELLER_PHONE=
BILLING_VAT_ENABLED=true
BILLING_VAT_NUMBER=
BILLING_VAT_RATE=20.00
BILLING_BANK_ACCOUNT_NAME=
BILLING_BANK_SORT_CODE=
BILLING_BANK_ACCOUNT_NUMBER=
BILLING_PAYMENT_TERMS_DAYS=7
BILLING_SUSPEND_AFTER_DAYS=14
BILLING_GENERATE_DAYS_BEFORE=7
BILLING_AUTO_ISSUE=false
BILLING_PRORATE=false

# GoCardless Direct Debit (module 1.12). Empty token = Direct Debit off. Webhook endpoint: {APP_URL}/webhooks/gocardless
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=
BILLING_MANDATE_GRACE_DAYS=3
BILLING_MANDATE_DEADLINE_DAYS=3
BILLING_DD_REMINDER_DAYS=5

# Licence signing (contract v1.4.1 ANSWERS §7): the owner's key generator, kid k290bee23. Approver of our signer
# certificate, and trusted for local keys in licence/redeem and cloud/migrate. Tills send their own lists; never hard-code.
LICENCE_APPROVERS=k290bee23:krfekeNJrdI3V7ebkpxEA1RaK21yAX_eX8iXtFIUMlE
LICENCE_TRUSTED_KEYS=k290bee23:krfekeNJrdI3V7ebkpxEA1RaK21yAX_eX8iXtFIUMlE

# Till sync (module 2.1): only when sync runs on another https host than APP_URL (sent to tills as hubUrl).
SYNC_HUB_URL=

# Two-factor sign-in (off for now; set true to require it for admins and offer it to portal users)
TWO_FACTOR_ENABLED=false
