# Production .env for the retail-v2 backoffice. Copy to /var/www/retail-v2/shared/.env on the server (chmod 600,
# owner = app user), fill every CHANGE_ME, never commit the real file. Runbook: docs/deploy.md.
# Keys not listed here keep the defaults in config/*.php.

APP_NAME="Switch & Save"
APP_ENV=production
# Generate ON THE SERVER (docs/deploy.md 3.1): php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# (same format as `php artisan key:generate --show`) → paste here. Back it up with the DB backups' keys:
# licence signing secrets, licence-key and sync-key hashes are keyed with it (docs/DECISIONS.md "APP_KEY").
# Never change it casually: to rotate, move the old value to APP_PREVIOUS_KEYS, then run licence:keys:rotate.
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://CHANGE_ME.example.co.uk

# Country profile of this instance (config/country.php, docs/pakistan-plan.md): GB on the UK server (write it
# explicitly), PK on the Pakistan server. Missing, blank or unknown = GB.
COUNTRY=GB

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# One file, rotated by /etc/logrotate.d/retail-v2 (14 days).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=retail_v2
DB_USERNAME=retail_v2
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# redis once Redis is installed (the live server has it since 2026-10-06; database works without it).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# database works out of the box. With Redis installed (INSTALL_REDIS=yes in deploy/server-setup.sh; the live server
# since 2026-10-06): QUEUE_CONNECTION=redis, CACHE_STORE=redis, SESSION_DRIVER=redis, REDIS_PREFIX=retail_v2_, and the
# worker command `queue:work redis`. Admin System health counts waiting jobs on either.
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=retail_v2_
# Optional dedicated queue for report rebuilds; add it to the worker's --queue list (deploy/supervisor).
REPORTS_QUEUE=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@CHANGE_ME.example.co.uk"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_MARKDOWN_THEME=switch-save

# Switch & Save business details used in emails (config/sspos.php)
SSPOS_SUPPORT_EMAIL=support@switchandsave.co.uk
SSPOS_SUPPORT_PHONE=
SSPOS_STAFF_EMAIL=
SSPOS_LEAD_ALERT_EMAILS=
# Our public website, named in messages (phase P6). A Pakistan instance sets its own, e.g. https://switchandsave.pk
SSPOS_WEBSITE_URL=https://switchandsave.co.uk
SSPOS_EPOS_DOWNLOAD_URL=https://switchandsave.co.uk/download
SSPOS_PORTAL_URL="${APP_URL}"
SSPOS_EMAIL_LOG_RETENTION_MONTHS=12

# Public trial form (module 1.10). Production REFUSES the form without TURNSTILE_SECRET.
PUBLIC_FORM_ORIGINS=https://switchandsave.co.uk
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET=CHANGE_ME

VITE_APP_NAME="${APP_NAME}"

# AI (module 6.1, docs/ai.md). Empty key = AI features show "not set up yet".
ANTHROPIC_API_KEY=
AI_ENABLED=true
AI_MODEL=claude-sonnet-5
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_MONTHLY_TOKENS=2000000
AI_USD_TO_GBP=0.79

# Billing (modules 1.8, 1.13): the seller on invoices, VAT and the bank for transfers.
BILLING_SELLER_NAME="Switch & Save"
BILLING_SELLER_LEGAL_NAME="Switch & Save Ltd"
BILLING_SELLER_ADDRESS=CHANGE_ME
BILLING_SELLER_COMPANY_NUMBER=CHANGE_ME
# "Registered in …, company no. …" on our invoices (phase P6). Empty = the country profile's place:
# England and Wales (GB), Pakistan (PK). Support contact per instance: SSPOS_SUPPORT_EMAIL / SSPOS_SUPPORT_PHONE.
BILLING_SELLER_REGISTERED_IN="England and Wales"
BILLING_SELLER_EMAIL=CHANGE_ME
BILLING_SELLER_PHONE=
BILLING_VAT_ENABLED=true
BILLING_VAT_NUMBER=CHANGE_ME
BILLING_VAT_RATE=20.00
BILLING_BANK_ACCOUNT_NAME=CHANGE_ME
BILLING_BANK_SORT_CODE=CHANGE_ME
BILLING_BANK_ACCOUNT_NUMBER=CHANGE_ME
BILLING_PAYMENT_TERMS_DAYS=7
BILLING_SUSPEND_AFTER_DAYS=7
BILLING_GENERATE_DAYS_BEFORE=7
BILLING_AUTO_ISSUE=false
BILLING_PRORATE=false

# GoCardless Direct Debit (module 1.12). Empty token = Direct Debit off. Webhook: {APP_URL}/webhooks/gocardless
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=live
GOCARDLESS_WEBHOOK_SECRET=
BILLING_MANDATE_GRACE_DAYS=3
BILLING_MANDATE_DEADLINE_DAYS=3
BILLING_DD_REMINDER_DAYS=5

# Manual collection (Pakistan plan P5): used only where the country profile collects fees by hand (COUNTRY=PK);
# ignored on GB (Direct Debit). Each period's invoice is due BILLING_MANUAL_DUE_DAYS after it is issued (billing:run
# issues it BILLING_GENERATE_DAYS_BEFORE days before the period, so normally on the period start). Reminder emails
# go this many days before and after the due date (and on it). How to pay, shown on invoices, emails and the portal
# Billing page; leave a value empty to hide that method.
BILLING_MANUAL_DUE_DAYS=7
BILLING_MANUAL_REMIND_BEFORE_DAYS=3
BILLING_MANUAL_REMIND_AFTER_DAYS=3
BILLING_PAY_BANK_NAME=
BILLING_PAY_BANK_ACCOUNT_TITLE=
BILLING_PAY_BANK_IBAN=
BILLING_PAY_JAZZCASH=
BILLING_PAY_EASYPAISA=
# Our own NTN and STRN on PK invoices (empty = hidden; COUNTRY=PK only). Off GB every BILLING_SELLER_* line is
# shown only when set: no UK defaults.
BILLING_SELLER_NTN=
BILLING_SELLER_STRN=

# Licence signing (contract v1.4.1 §17.2, §17.17). The signing key itself is NOT in .env: it is generated on the
# server with `php artisan licence:keys:generate` and stored encrypted (APP_KEY) in licence_signing_keys.
# Production never signs without the owner's signer certificate (licence:keys:import-cert).
LICENCE_ALLOW_UNCERTIFIED=false
LICENCE_ISSUER="SSPOS Portal"
LICENCE_HANDOVER_CONTACT=CHANGE_ME
# The owner's key generator (kid k290bee23): approver of our signer certificate, trusted for local keys.
LICENCE_APPROVERS=k290bee23:krfekeNJrdI3V7ebkpxEA1RaK21yAX_eX8iXtFIUMlE
LICENCE_TRUSTED_KEYS=k290bee23:krfekeNJrdI3V7ebkpxEA1RaK21yAX_eX8iXtFIUMlE
# Plan code given to new licences: create this plan on /admin/plans before issuing licences.
LICENCE_DEFAULT_PLAN=standard

# Till sync (module 2.1): only when sync runs on another https host than APP_URL (sent to tills as hubUrl).
SYNC_HUB_URL=
SYNC_RATE_LIMIT_PER_MINUTE=240

# Two-factor sign-in (off for now; set true to require it for admins and offer it to portal users)
TWO_FACTOR_ENABLED=false
