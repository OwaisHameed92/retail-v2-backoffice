{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:UpdateRun",
  "title": "UpdateRun",
  "description": "Payload of a UpdateRun row.",
  "type": "object",
  "properties": {
    "action": {
      "enum": [
        "checked",
        "downloaded",
        "installed",
        "refused",
        "migrated",
        "rolledBack",
        "versionChanged",
        "notesSeen"
      ]
    },
    "route": {
      "enum": [
        "operator",
        "scheduledTask",
        "startup"
      ]
    },
    "version": {
      "type": "string"
    },
    "fromVersion": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "isSuccess": {
      "type": "boolean"
    },
    "detail": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "registerId": {
      "type": "string"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "action",
    "route",
    "version",
    "fromVersion",
    "at",
    "isSuccess",
    "detail",
    "notes",
    "userId",
    "registerId",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
