{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:StockTake",
  "title": "StockTake",
  "description": "Payload of a StockTake row.",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "branch",
        "department",
        "category",
        "supplier",
        "productList"
      ]
    },
    "scopeId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "counting",
        "review",
        "approved",
        "cancelled"
      ]
    },
    "isBlind": {
      "type": "boolean"
    },
    "countUncountedAsZero": {
      "type": "boolean"
    },
    "startedByUserId": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "approvedByUserId": {
      "type": "string"
    },
    "approvedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "cancelledAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "recountThresholdValue": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "recountThresholdPercent": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "approvalOverValue": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "note": {
      "type": "string"
    },
    "isHighValueCount": {
      "type": "boolean"
    },
    "isClosed": {
      "type": "boolean"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "reference",
    "name",
    "scope",
    "scopeId",
    "status",
    "isBlind",
    "countUncountedAsZero",
    "startedByUserId",
    "startedAt",
    "approvedByUserId",
    "approvedAt",
    "cancelledAt",
    "recountThresholdValue",
    "recountThresholdPercent",
    "approvalOverValue",
    "note",
    "isHighValueCount",
    "isClosed",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
