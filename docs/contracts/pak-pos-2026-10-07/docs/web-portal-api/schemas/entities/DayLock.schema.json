{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:DayLock",
  "title": "DayLock",
  "description": "Payload of a DayLock row.",
  "type": "object",
  "properties": {
    "tradingDate": {
      "type": "string",
      "format": "date"
    },
    "lockedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lockedBy": {
      "type": "string"
    },
    "unlockedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "unlockedBy": {
      "type": "string"
    },
    "unlockReason": {
      "type": "string"
    },
    "isLocked": {
      "type": "boolean"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "tradingDate",
    "lockedAt",
    "lockedBy",
    "unlockedAt",
    "unlockedBy",
    "unlockReason",
    "isLocked",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
