{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:PurchaseOrder",
  "title": "PurchaseOrder",
  "description": "Payload of a PurchaseOrder row.",
  "type": "object",
  "properties": {
    "supplierId": {
      "type": "string"
    },
    "number": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "status": {
      "enum": [
        "draft",
        "sent",
        "partReceived",
        "received",
        "invoiced",
        "paid",
        "cancelled"
      ]
    },
    "expectedDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "sentAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sentByUserId": {
      "type": [
        "string",
        "null"
      ]
    },
    "cancelledAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "cancelledByUserId": {
      "type": [
        "string",
        "null"
      ]
    },
    "cancelReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "netTotal": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "vatTotal": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "grossTotal": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "discountAmount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "discountReasonId": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin": {
      "enum": [
        "branch",
        "headOffice"
      ]
    },
    "isFromHeadOffice": {
      "type": "boolean"
    },
    "orderNo": {
      "type": [
        "string",
        "null"
      ]
    },
    "branchCode": {
      "type": "string"
    },
    "reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "hasReceivingStarted": {
      "type": "boolean"
    },
    "net": {
      "type": "object",
      "properties": {
        "amount": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
        },
        "pence": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)$"
        },
        "isZero": {
          "type": "boolean"
        },
        "isNegative": {
          "type": "boolean"
        }
      },
      "required": [
        "amount",
        "pence",
        "isZero",
        "isNegative"
      ]
    },
    "vat": {
      "type": "object",
      "properties": {
        "amount": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
        },
        "pence": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)$"
        },
        "isZero": {
          "type": "boolean"
        },
        "isNegative": {
          "type": "boolean"
        }
      },
      "required": [
        "amount",
        "pence",
        "isZero",
        "isNegative"
      ]
    },
    "gross": {
      "type": "object",
      "properties": {
        "amount": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
        },
        "pence": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)$"
        },
        "isZero": {
          "type": "boolean"
        },
        "isNegative": {
          "type": "boolean"
        }
      },
      "required": [
        "amount",
        "pence",
        "isZero",
        "isNegative"
      ]
    },
    "isEditable": {
      "type": "boolean"
    },
    "isOpen": {
      "type": "boolean"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "supplierId",
    "number",
    "status",
    "expectedDate",
    "sentAt",
    "sentByUserId",
    "cancelledAt",
    "cancelledByUserId",
    "cancelReason",
    "notes",
    "netTotal",
    "vatTotal",
    "grossTotal",
    "discountAmount",
    "discountReasonId",
    "origin",
    "isFromHeadOffice",
    "orderNo",
    "branchCode",
    "reference",
    "hasReceivingStarted",
    "net",
    "vat",
    "gross",
    "isEditable",
    "isOpen",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
