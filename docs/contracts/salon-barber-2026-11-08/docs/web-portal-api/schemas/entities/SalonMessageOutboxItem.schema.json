{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:SalonMessageOutboxItem",
  "title": "SalonMessageOutboxItem",
  "description": "Payload of a SalonMessageOutboxItem row.",
  "type": "object",
  "properties": {
    "automationKey": {
      "type": "string"
    },
    "purpose": {
      "enum": [
        "service",
        "marketing"
      ]
    },
    "customerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "toPhone": {
      "type": "string"
    },
    "toEmail": {
      "type": "string"
    },
    "channelOrder": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "dueAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "queued",
        "sent",
        "failed",
        "skipped",
        "cancelled"
      ]
    },
    "attempts": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "lastError": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "refType": {
      "type": "string"
    },
    "refId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sentChannel": {
      "enum": [
        "whatsApp",
        "sms",
        "email",
        null
      ]
    },
    "sentAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "providerMessageId": {
      "type": "string"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "automationKey",
    "purpose",
    "customerId",
    "toPhone",
    "toEmail",
    "channelOrder",
    "subject",
    "body",
    "dueAt",
    "status",
    "attempts",
    "lastError",
    "idempotencyKey",
    "refType",
    "refId",
    "sentChannel",
    "sentAt",
    "providerMessageId",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
