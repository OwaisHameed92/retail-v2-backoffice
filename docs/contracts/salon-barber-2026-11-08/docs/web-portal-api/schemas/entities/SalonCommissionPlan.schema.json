{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:SalonCommissionPlan",
  "title": "SalonCommissionPlan",
  "description": "Payload of a SalonCommissionPlan row.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "servicePercent": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "retailPercent": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "tierMode": {
      "enum": [
        "marginal",
        "wholeAmount"
      ]
    },
    "period": {
      "enum": [
        "week",
        "fourWeeks",
        "month"
      ]
    },
    "costDeduction": {
      "enum": [
        "none",
        "beforeRate",
        "afterRate"
      ]
    },
    "rebookCredit": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "payRule": {
      "enum": [
        "commissionOnly",
        "hourlyPlusCommission",
        "higherOfHourlyOrCommission"
      ]
    },
    "isActive": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "name",
    "servicePercent",
    "retailPercent",
    "tierMode",
    "period",
    "costDeduction",
    "rebookCredit",
    "payRule",
    "isActive",
    "note",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
