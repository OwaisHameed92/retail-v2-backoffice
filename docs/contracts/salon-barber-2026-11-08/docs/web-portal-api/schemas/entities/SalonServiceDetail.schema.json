{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:SalonServiceDetail",
  "title": "SalonServiceDetail",
  "description": "Payload of a SalonServiceDetail row.",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string"
    },
    "durationMin": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "processingMin": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "finishMin": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "isPriceFrom": {
      "type": "boolean"
    },
    "isOnlineBookable": {
      "type": "boolean"
    },
    "onlineName": {
      "type": "string"
    },
    "onlineDescription": {
      "type": "string"
    },
    "clientGroup": {
      "enum": [
        "everyone",
        "men",
        "women",
        "kids"
      ]
    },
    "needsPatchTest": {
      "type": "boolean"
    },
    "patchTestValidDays": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "commissionCategory": {
      "type": "string"
    },
    "colourHex": {
      "type": "string"
    },
    "depositAmount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "rebookAfterWeeks": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "resourceKind": {
      "enum": [
        "chair",
        "room",
        "basin",
        "station",
        "other",
        null
      ]
    },
    "isAddOnOnly": {
      "type": "boolean"
    },
    "sortOrder": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "productId",
    "durationMin",
    "processingMin",
    "finishMin",
    "isPriceFrom",
    "isOnlineBookable",
    "onlineName",
    "onlineDescription",
    "clientGroup",
    "needsPatchTest",
    "patchTestValidDays",
    "commissionCategory",
    "colourHex",
    "depositAmount",
    "rebookAfterWeeks",
    "resourceKind",
    "isAddOnOnly",
    "sortOrder",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
