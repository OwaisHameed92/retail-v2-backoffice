{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoodsReceipt (hubDrafted)",
  "description": "PROPOSAL pda-stock-drafts §5.3: one delivery booked against a purchase order of the shop, drafted on the portal: the v1.4.1 GoodsReceipt row plus origin (new). The till posts it (status posted) or cancels it with cancelReason. No $id on purpose: the $ref is relative to this file.",
  "allOf": [
    {
      "$ref": "../../../portal-api-v1.4.1/docs/web-portal-api/schemas/entities/GoodsReceipt.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "origin": {
      "const": "headOffice"
    },
    "status": {
      "const": "draft"
    },
    "purchaseOrderId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "supplierId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "receivedByUserId": {
      "const": ""
    },
    "postedAt": {
      "type": "null"
    },
    "cancelledAt": {
      "type": "null"
    },
    "cancelReason": {
      "type": "null"
    },
    "branchId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "rowVersion": {
      "enum": [
        0,
        "0"
      ]
    }
  },
  "required": [
    "origin"
  ]
}
