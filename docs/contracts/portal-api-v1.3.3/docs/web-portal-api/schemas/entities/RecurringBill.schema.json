{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:RecurringBill",
  "title": "RecurringBill",
  "description": "Payload of a RecurringBill row.",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "reasonId": {
      "type": "string"
    },
    "supplierId": {
      "type": "string"
    },
    "payeeName": {
      "type": "string"
    },
    "net": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "vatRateId": {
      "type": "string"
    },
    "paymentType": {
      "enum": [
        "cash",
        "card",
        "bank",
        "owner"
      ]
    },
    "frequency": {
      "enum": [
        "monthly",
        "weekly",
        "quarterly",
        "annually"
      ]
    },
    "dueDay": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "nextDueDate": {
      "type": "string",
      "format": "date"
    },
    "isActive": {
      "type": "boolean"
    },
    "lastExpenseId": {
      "type": "string"
    },
    "lastRecordedDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "note": {
      "type": "string"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "description",
    "reasonId",
    "supplierId",
    "payeeName",
    "net",
    "vatRateId",
    "paymentType",
    "frequency",
    "dueDay",
    "nextDueDate",
    "isActive",
    "lastExpenseId",
    "lastRecordedDate",
    "note",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
