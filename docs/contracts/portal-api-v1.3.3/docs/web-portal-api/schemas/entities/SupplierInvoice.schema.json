{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:SupplierInvoice",
  "title": "SupplierInvoice",
  "description": "Payload of a SupplierInvoice row.",
  "type": "object",
  "properties": {
    "supplierId": {
      "type": "string"
    },
    "supplierName": {
      "type": "string"
    },
    "invoiceNumber": {
      "type": "string"
    },
    "invoiceDate": {
      "type": "string",
      "format": "date"
    },
    "dueDate": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "draft",
        "matched",
        "approved",
        "partPaid",
        "paid",
        "disputed"
      ]
    },
    "netAmount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "vatAmount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "grossAmount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "amountPaid": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "balance": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "varianceFlags": {
      "type": "string"
    },
    "matchedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approvedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approvedByUserId": {
      "type": [
        "string",
        "null"
      ]
    },
    "disputedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "disputeReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "attachmentPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "supplierId",
    "supplierName",
    "invoiceNumber",
    "invoiceDate",
    "dueDate",
    "status",
    "netAmount",
    "vatAmount",
    "grossAmount",
    "amountPaid",
    "balance",
    "varianceFlags",
    "matchedAt",
    "approvedAt",
    "approvedByUserId",
    "disputedAt",
    "disputeReason",
    "attachmentPath",
    "notes",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
