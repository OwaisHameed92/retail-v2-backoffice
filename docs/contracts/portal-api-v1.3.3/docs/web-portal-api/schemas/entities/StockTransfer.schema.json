{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:StockTransfer",
  "title": "StockTransfer",
  "description": "Payload of a StockTransfer row.",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "fromBranchId": {
      "type": "string"
    },
    "toBranchId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "requested",
        "dispatched",
        "received",
        "closed",
        "cancelled"
      ]
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestedByUserId": {
      "type": "string"
    },
    "dispatchedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "dispatchedByUserId": {
      "type": "string"
    },
    "dispatchedCost": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "isReturn": {
      "type": "boolean"
    },
    "returnOfTransferId": {
      "type": [
        "string",
        "null"
      ]
    },
    "note": {
      "type": "string"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "reference",
    "fromBranchId",
    "toBranchId",
    "status",
    "requestedAt",
    "requestedByUserId",
    "dispatchedAt",
    "dispatchedByUserId",
    "dispatchedCost",
    "isReturn",
    "returnOfTransferId",
    "note",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
