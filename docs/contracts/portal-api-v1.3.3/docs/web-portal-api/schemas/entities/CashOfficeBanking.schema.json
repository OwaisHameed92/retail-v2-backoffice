{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:CashOfficeBanking",
  "title": "CashOfficeBanking",
  "description": "Payload of a CashOfficeBanking row.",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "amount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "denominationsJson": {
      "type": "string"
    },
    "status": {
      "enum": [
        "prepared",
        "banked",
        "cancelled",
        "inTransit"
      ]
    },
    "preparedByUserId": {
      "type": "string"
    },
    "preparedAt": {
      "type": "string",
      "format": "date-time"
    },
    "bankedByUserId": {
      "type": "string"
    },
    "bankedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "bankReference": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "sealNumber": {
      "type": "string"
    },
    "collectionMethod": {
      "enum": [
        "ownBanking",
        "carrier"
      ]
    },
    "carrierName": {
      "type": "string"
    },
    "collectedSignatureName": {
      "type": "string"
    },
    "collectedByUserId": {
      "type": "string"
    },
    "collectedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "confirmedAmount": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "varianceAmount": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "reference",
    "amount",
    "denominationsJson",
    "status",
    "preparedByUserId",
    "preparedAt",
    "bankedByUserId",
    "bankedAt",
    "bankReference",
    "note",
    "sealNumber",
    "collectionMethod",
    "carrierName",
    "collectedSignatureName",
    "collectedByUserId",
    "collectedAt",
    "confirmedAmount",
    "varianceAmount",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
