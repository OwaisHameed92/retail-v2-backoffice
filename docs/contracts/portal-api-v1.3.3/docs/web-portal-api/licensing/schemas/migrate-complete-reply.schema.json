{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "migrate-complete-reply",
  "description": "POST /api/v1/cloud/migrate/complete 200 reply.",
  "type": "object",
  "properties": {
    "uploadId": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ],
      "description": "incomplete = resend from resumeFromSeq, then call complete again. Unknown = incomplete."
    },
    "received": {
      "type": "integer",
      "minimum": 0
    },
    "resumeFromSeq": {
      "type": "integer",
      "minimum": 0
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string"
          },
          "expected": {
            "type": "integer"
          },
          "received": {
            "type": "integer"
          }
        },
        "required": [
          "entity",
          "expected",
          "received"
        ]
      }
    },
    "pushResumesAfterSeq": {
      "type": "integer",
      "minimum": 0,
      "description": "The portal's push cursor for this branch = snapshotChangeLogSeq."
    },
    "portalTimeUtc": {
      "$ref": "common.schema.json#/$defs/utc"
    },
    "messages": {
      "$ref": "common.schema.json#/$defs/messages"
    }
  },
  "required": [
    "uploadId",
    "status",
    "received",
    "resumeFromSeq",
    "missing",
    "pushResumesAfterSeq",
    "portalTimeUtc"
  ]
}
