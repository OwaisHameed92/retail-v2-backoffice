{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deactivate-reply",
  "description": "POST /api/v1/devices/deactivate 200 reply. Idempotent: deactivating an already deactivated register returns the same reply.",
  "type": "object",
  "properties": {
    "registerId": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "seat": {
      "$ref": "common.schema.json#/$defs/seatState"
    },
    "seatsInUse": {
      "type": "integer",
      "minimum": 0
    },
    "maxRegisters": {
      "type": "integer",
      "minimum": 1
    },
    "apiKeyRevoked": {
      "type": "boolean",
      "description": "true when the main till released itself: the branch key stops working now."
    },
    "transferCode": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/activationCode"
        },
        {
          "type": "null"
        }
      ],
      "description": "When the main till released itself: a one-time activation code for the replacement PC."
    },
    "transferCodeExpiresAt": {
      "$ref": "common.schema.json#/$defs/utcOrNull"
    },
    "portalTimeUtc": {
      "$ref": "common.schema.json#/$defs/utc"
    },
    "messages": {
      "$ref": "common.schema.json#/$defs/messages"
    }
  },
  "required": [
    "registerId",
    "seat",
    "seatsInUse",
    "maxRegisters",
    "apiKeyRevoked",
    "transferCode",
    "transferCodeExpiresAt",
    "portalTimeUtc"
  ]
}
