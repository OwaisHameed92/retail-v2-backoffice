{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:Shift",
  "title": "Shift",
  "description": "Payload of a Shift row.",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "openedAt": {
      "type": "string",
      "format": "date-time"
    },
    "closedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "openingFloat": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "closedBy": {
      "type": "string"
    },
    "overrideBy": {
      "type": "string"
    },
    "overrideReason": {
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "varianceTotal": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "closeNotes": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "perTill",
        "perCashier",
        "floatingCashier"
      ]
    },
    "drawerOwnerUserId": {
      "type": "string"
    },
    "isOpen": {
      "type": "boolean"
    },
    "registerId": {
      "type": "string"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "userId",
    "openedAt",
    "closedAt",
    "openingFloat",
    "closedBy",
    "overrideBy",
    "overrideReason",
    "status",
    "varianceTotal",
    "closeNotes",
    "mode",
    "drawerOwnerUserId",
    "isOpen",
    "registerId",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
