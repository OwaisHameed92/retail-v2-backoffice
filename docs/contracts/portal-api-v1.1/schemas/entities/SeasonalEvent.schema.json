{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:SeasonalEvent",
  "title": "SeasonalEvent",
  "description": "Payload of a SeasonalEvent row.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "fixed",
        "moveable",
        "bankHoliday",
        "schoolHoliday",
        "local"
      ]
    },
    "startsOn": {
      "type": "string",
      "format": "date"
    },
    "endsOn": {
      "type": "string",
      "format": "date"
    },
    "nation": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "isActive": {
      "type": "boolean"
    },
    "days": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "name",
    "kind",
    "startsOn",
    "endsOn",
    "nation",
    "notes",
    "isActive",
    "days",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
