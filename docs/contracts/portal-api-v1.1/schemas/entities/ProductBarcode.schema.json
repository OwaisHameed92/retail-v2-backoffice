{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:ProductBarcode",
  "title": "ProductBarcode",
  "description": "Payload of a ProductBarcode row.",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string"
    },
    "barcode": {
      "type": "string"
    },
    "packQty": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "isPrimary": {
      "type": "boolean"
    },
    "unitCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "productUnitId": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "enum": [
        "internal",
        "supplier",
        "plu",
        "weighted",
        "coupon",
        "gs1"
      ]
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "productId",
    "barcode",
    "packQty",
    "isPrimary",
    "unitCode",
    "productUnitId",
    "source",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
