            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "pageId",
    "lineNumber",
    "kind",
    "entryDate",
    "quantity",
    "supplierName",
    "supplierAddress",
    "invoiceReference",
