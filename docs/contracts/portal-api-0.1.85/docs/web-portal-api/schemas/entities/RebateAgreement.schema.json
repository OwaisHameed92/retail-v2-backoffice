{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:RebateAgreement",
  "title": "RebateAgreement",
  "description": "Payload of a RebateAgreement row.",
  "type": "object",
  "properties": {
    "supplierId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "supplier",
        "department",
        "product"
      ]
    },
    "scopeId": {
      "type": "string"
    },
    "basis": {
      "enum": [
        "percentOfSpend",
        "perUnit"
      ]
    },
    "rate": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "periodFrom": {
      "type": "string",
      "format": "date"
    },
    "periodTo": {
      "type": "string",
      "format": "date"
    },
    "threshold": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "isActive": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "supplierId",
    "name",
    "scope",
    "scopeId",
    "basis",
    "rate",
    "periodFrom",
    "periodTo",
    "threshold",
    "isActive",
    "note",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
