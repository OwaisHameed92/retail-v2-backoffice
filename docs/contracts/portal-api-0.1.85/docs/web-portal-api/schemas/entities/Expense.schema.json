{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:Expense",
  "title": "Expense",
  "description": "Payload of a Expense row.",
  "type": "object",
  "properties": {
    "shiftId": {
      "type": "string"
    },
    "registerId": {
      "type": "string"
    },
    "reasonId": {
      "type": "string"
    },
    "supplierId": {
      "type": "string"
    },
    "payeeName": {
      "type": "string"
    },
    "receiptRef": {
      "type": "string"
    },
    "receiptFile": {
      "type": "string"
    },
    "vatReceiptHeld": {
      "type": "boolean"
    },
    "net": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "vatRateId": {
      "type": "string"
    },
    "vat": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "gross": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "paymentType": {
      "enum": [
        "cash",
        "card",
        "bank",
        "owner"
      ]
    },
    "mileageMiles": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "recurringBillId": {
      "type": "string"
    },
    "cashMovementId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "expenseDate": {
      "type": "string",
      "format": "date"
    },
    "note": {
      "type": "string"
    },
    "isVoided": {
      "type": "boolean"
    },
    "voidedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "voidedByUserId": {
      "type": "string"
    },
    "voidReason": {
      "type": "string"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "shiftId",
    "registerId",
    "reasonId",
    "supplierId",
    "payeeName",
    "receiptRef",
    "receiptFile",
    "vatReceiptHeld",
    "net",
    "vatRateId",
    "vat",
    "gross",
    "paymentType",
    "mileageMiles",
    "recurringBillId",
    "cashMovementId",
    "userId",
    "expenseDate",
    "note",
    "isVoided",
    "voidedAt",
    "voidedByUserId",
    "voidReason",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
