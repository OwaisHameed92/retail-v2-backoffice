{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:CdReturnEntry",
  "title": "CdReturnEntry",
  "description": "Payload of a CdReturnEntry row.",
  "type": "object",
  "properties": {
    "entryNumber": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "kind": {
      "enum": [
        "returned",
        "destroyed"
      ]
    },
    "returnEntryId": {
      "type": "string"
    },
    "entryDate": {
      "type": "string",
      "format": "date"
    },
    "drug": {
      "type": "string"
    },
    "quantity": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "unit": {
      "type": "string"
    },
    "returnedBy": {
      "type": "string"
    },
    "witnessUserId": {
      "type": "string"
    },
    "witnessName": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "recordedByUserId": {
      "type": "string"
    },
    "recordedByName": {
      "type": "string"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "entryNumber",
    "kind",
    "returnEntryId",
    "entryDate",
    "drug",
    "quantity",
    "unit",
    "returnedBy",
    "witnessUserId",
    "witnessName",
    "note",
    "recordedByUserId",
    "recordedByName",
    "recordedAt",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
