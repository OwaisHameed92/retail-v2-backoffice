{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:MedicineRefusal",
  "title": "MedicineRefusal",
  "description": "Payload of a MedicineRefusal row.",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "reason": {
      "enum": [
        "notSuitable",
        "interaction",
        "possibleMisuse",
        "referToDoctor",
        "ageOrPregnancy",
        "other"
      ]
    },
    "note": {
      "type": "string"
    },
    "refusedByUserId": {
      "type": "string"
    },
    "refusedByName": {
      "type": "string"
    },
    "responsiblePharmacistName": {
      "type": "string"
    },
    "cartId": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "registerId": {
      "type": "string"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "productId",
    "productName",
    "reason",
    "note",
    "refusedByUserId",
    "refusedByName",
    "responsiblePharmacistName",
    "cartId",
    "at",
    "registerId",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
