{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:BranchProduct",
  "title": "BranchProduct",
  "description": "Payload of a BranchProduct row.",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string"
    },
    "isActive": {
      "type": "boolean"
    },
    "tilePosition": {
      "type": [
        "string",
        "integer",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "tileColourHex": {
      "type": [
        "string",
        "null"
      ]
    },
    "priceOverride": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "qtyOnHand": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "qtyReserved": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "qtyAvailable": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "isStockTracked": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "reorderPoint": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "minQty": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "maxQty": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "productId",
    "isActive",
    "tilePosition",
    "tileColourHex",
    "priceOverride",
    "qtyOnHand",
    "qtyReserved",
    "qtyAvailable",
    "isStockTracked",
    "reorderPoint",
    "minQty",
    "maxQty",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
