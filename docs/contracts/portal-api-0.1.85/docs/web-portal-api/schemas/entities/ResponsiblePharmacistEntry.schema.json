{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:ResponsiblePharmacistEntry",
  "title": "ResponsiblePharmacistEntry",
  "description": "Payload of a ResponsiblePharmacistEntry row.",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "signedIn",
        "signedOut",
        "absenceStarted",
        "absenceEnded",
        "correction"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "pharmacistUserId": {
      "type": "string"
    },
    "pharmacistName": {
      "type": "string"
    },
    "registrationNumber": {
      "type": "string"
    },
    "recordedByUserId": {
      "type": "string"
    },
    "recordedByName": {
      "type": "string"
    },
    "correctsEntryId": {
      "type": "string"
    },
    "overAbsenceLimit": {
      "type": "boolean"
    },
    "followsSessionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "note": {
      "type": "string"
    },
    "registerId": {
      "type": "string"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "sessionId",
    "kind",
    "at",
    "pharmacistUserId",
    "pharmacistName",
    "registrationNumber",
    "recordedByUserId",
    "recordedByName",
    "correctsEntryId",
    "overAbsenceLimit",
    "followsSessionId",
    "note",
    "registerId",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
