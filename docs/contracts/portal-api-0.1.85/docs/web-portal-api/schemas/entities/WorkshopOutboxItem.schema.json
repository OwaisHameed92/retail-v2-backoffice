{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:WorkshopOutboxItem",
  "title": "WorkshopOutboxItem",
  "description": "Payload of a WorkshopOutboxItem row.",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "paid",
        "refund",
        "completed",
        "cancelled",
        "received",
        "assetCreated",
        "bookingCreated",
        "readyMessage"
      ]
    },
    "workshopOrderId": {
      "type": "string"
    },
    "saleId": {
      "type": [
        "string",
        "null"
      ]
    },
    "amount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "payloadJson": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "sent",
        "failed",
        "stopped"
      ]
    },
    "attempts": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "nextAttemptAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lastError": {
      "type": "string"
    },
    "sentAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "externalResultId": {
      "type": "string"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "kind",
    "workshopOrderId",
    "saleId",
    "amount",
    "payloadJson",
    "idempotencyKey",
    "status",
    "attempts",
    "nextAttemptAt",
    "lastError",
    "sentAt",
    "externalResultId",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
