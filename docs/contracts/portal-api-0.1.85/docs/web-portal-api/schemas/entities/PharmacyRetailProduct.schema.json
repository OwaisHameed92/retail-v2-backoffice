{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:PharmacyRetailProduct",
  "title": "PharmacyRetailProduct",
  "description": "Payload of a PharmacyRetailProduct row.",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string"
    },
    "pipCode": {
      "type": "string"
    },
    "rrp": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "disabledReliefEligible": {
      "type": "boolean"
    },
    "pharmacyFirst": {
      "enum": [
        "none",
        "soreThroat",
        "sinusitis",
        "earache",
        "infectedInsectBite",
        "impetigo",
        "shingles",
        "uncomplicatedUti"
      ]
    },
    "isBlank": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "productId",
    "pipCode",
    "rrp",
    "disabledReliefEligible",
    "pharmacyFirst",
    "isBlank",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
