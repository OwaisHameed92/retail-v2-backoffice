      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "ageRule": {
      "enum": [
        "none",
        "over16",
        "over18",
        "tobaccoGenerational",
        "nicotine",
        "lottery18",
        "knives18",
        "fireworks18",
        "solvents18",
        "energyDrink16",
        "paracetamol16"
      ]
    },
    "userId": {
      "type": "string"
    },
    "operatorName": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "registerId": {
      "type": "string"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
