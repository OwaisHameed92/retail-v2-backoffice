{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:PharmacyRegisterNote",
  "title": "PharmacyRegisterNote",
  "description": "Payload of a PharmacyRegisterNote row.",
  "type": "object",
  "properties": {
    "register": {
      "enum": [
        "pom",
        "specials",
        "cdReturns"
      ]
    },
    "entryId": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "correction",
        "prescriptionReceived",
        "adverseReaction"
      ]
    },
    "noteDate": {
      "type": "string",
      "format": "date"
    },
    "prescriptionDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "text": {
      "type": "string"
    },
    "recordedByUserId": {
      "type": "string"
    },
    "recordedByName": {
      "type": "string"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "register",
    "entryId",
    "kind",
    "noteDate",
    "prescriptionDate",
    "text",
    "recordedByUserId",
    "recordedByName",
    "recordedAt",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
