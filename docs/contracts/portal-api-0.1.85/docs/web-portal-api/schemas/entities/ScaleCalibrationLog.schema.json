{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:ScaleCalibrationLog",
  "title": "ScaleCalibrationLog",
  "description": "Payload of a ScaleCalibrationLog row.",
  "type": "object",
