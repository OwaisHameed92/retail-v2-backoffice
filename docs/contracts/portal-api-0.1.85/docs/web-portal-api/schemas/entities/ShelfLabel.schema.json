{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:ShelfLabel",
  "title": "ShelfLabel",
  "description": "Payload of a ShelfLabel row.",
  "type": "object",
  "properties": {
    "vendorLabelId": {
      "type": "string"
    },
    "vendorKey": {
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "boundAt": {
      "type": "string",
      "format": "date-time"
    },
    "boundByUserId": {
      "type": "string"
    },
    "lastPushedSellPrice": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "lastPushedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lastPushError": {
      "type": "string"
    },
    "consecutiveFailures": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "vendorLabelId",
    "vendorKey",
    "productId",
    "boundAt",
    "boundByUserId",
    "lastPushedSellPrice",
    "lastPushedAt",
    "lastPushError",
    "consecutiveFailures",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
