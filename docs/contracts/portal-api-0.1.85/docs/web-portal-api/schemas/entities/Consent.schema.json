{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:Consent",
  "title": "Consent",
  "description": "Payload of a Consent row.",
  "type": "object",
  "properties": {
    "customerId": {
      "type": "string"
    },
    "channel": {
      "enum": [
        "email",
        "sms",
        "whatsApp",
        "post"
      ]
    },
    "given": {
      "type": "boolean"
    },
    "source": {
      "enum": [
        "till",
        "web",
        "form"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "withdrawnAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isActive": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "customerId",
    "channel",
    "given",
    "source",
    "at",
    "withdrawnAt",
    "isActive",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
