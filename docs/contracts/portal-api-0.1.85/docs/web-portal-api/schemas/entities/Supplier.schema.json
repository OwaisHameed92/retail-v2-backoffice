{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:Supplier",
  "title": "Supplier",
  "description": "Payload of a Supplier row.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "isActive": {
      "type": "boolean"
    },
    "contactName": {
      "type": [
        "string",
        "null"
      ]
    },
    "phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "addressLine1": {
      "type": [
        "string",
        "null"
      ]
    },
    "addressLine2": {
      "type": [
        "string",
        "null"
      ]
    },
    "town": {
      "type": [
        "string",
        "null"
      ]
    },
    "postcode": {
      "type": [
        "string",
        "null"
      ]
    },
    "accountNumber": {
      "type": [
        "string",
        "null"
      ]
    },
    "termsKind": {
      "enum": [
        "prepay",
        "onDelivery",
        "netDays",
        "endOfMonth"
      ]
    },
    "paymentTermsDays": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "defaultLeadDays": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "minimumOrderValue": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "minimumOrder": {
      "type": "object",
      "properties": {
        "amount": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
        },
        "pence": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)$"
        },
        "isZero": {
          "type": "boolean"
        },
        "isNegative": {
          "type": "boolean"
        }
      },
      "required": [
        "amount",
        "pence",
        "isZero",
        "isNegative"
      ]
    },
    "orderMethod": {
      "enum": [
        "email",
        "phone",
        "portal",
        "rep",
        "edi"
      ]
    },
    "deliveryDays": {
      "type": "string"
    },
    "vatNumber": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "name",
    "code",
    "isActive",
    "contactName",
    "phone",
    "email",
    "addressLine1",
    "addressLine2",
    "town",
    "postcode",
    "accountNumber",
    "termsKind",
    "paymentTermsDays",
    "defaultLeadDays",
    "minimumOrderValue",
    "minimumOrder",
    "orderMethod",
    "deliveryDays",
    "vatNumber",
    "notes",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
