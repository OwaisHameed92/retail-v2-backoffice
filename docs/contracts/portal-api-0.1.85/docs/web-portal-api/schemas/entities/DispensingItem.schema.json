{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:DispensingItem",
  "title": "DispensingItem",
  "description": "Payload of a DispensingItem row.",
  "type": "object",
  "properties": {
    "dispensingRecordId": {
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "quantity": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "directions": {
      "type": "string"
    },
    "freeOfChargeReason": {
      "enum": [
        "none",
        "aged60OrOver",
        "under16",
        "aged16To18InEducation",
        "maternityExemption",
        "medicalExemption",
        "prepaymentCertificate",
        "warPension",
        "lowIncomeHc2",
        "benefits",
        "taxCredit",
        "freeInNation",
        "agedUnder16Or60Plus",
        "fullTimeEducation16To18",
        "hrtPrepaymentCertificate",
        "incomeRelatedEsa",
        "incomeBasedJsa",
        "pensionCreditGuaranteeCredit",
        "universalCredit",
        "freeContraceptive",
        "sexualHealthOrTuberculosis",
        "prisonerOnRelease"
      ]
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "dispensingRecordId",
    "productId",
    "description",
    "quantity",
    "directions",
    "freeOfChargeReason",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
