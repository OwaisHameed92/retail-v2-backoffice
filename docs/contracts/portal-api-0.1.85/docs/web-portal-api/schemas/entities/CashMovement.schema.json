{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:CashMovement",
  "title": "CashMovement",
  "description": "Payload of a CashMovement row.",
  "type": "object",
  "properties": {
    "shiftId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "type": {
      "enum": [
        "openingFloat",
        "paidIn",
        "paidOut",
        "safeDrop",
        "bankDrop",
        "floatTopUp",
        "closingCount",
        "sale",
        "refund",
        "counterfeit",
        "pettyCashOut",
        "pettyCashIn",
        "changeOrderReceived",
        "cashReconciliationVariance",
        "safeBankDrop",
        "voucherSale",
        "accountPayment",
        "customerAdvance",
        "customerAdvanceRefund"
      ]
    },
    "amount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "reasonId": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "registerId": {
      "type": "string"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "shiftId",
    "userId",
    "type",
    "amount",
    "reasonId",
    "note",
    "at",
    "registerId",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
