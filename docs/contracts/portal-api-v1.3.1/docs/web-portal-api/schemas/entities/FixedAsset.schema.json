            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "name",
    "code",
    "fixedAssetCategoryId",
    "purchaseDate",
    "purchaseCostAmount",
    "supplierId",
    "usefulLifeYears",
    "depreciationRatePercent",
    "residualValueAmount",
    "disposalDate",
    "disposalProceedsAmount",
    "isActive",
    "notes",
    "purchaseCost",
    "residualValue",
    "disposalProceeds",
    "isDisposed",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
