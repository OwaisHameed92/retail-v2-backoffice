      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "fixedAssetCategoryId": {
      "type": "string"
    },
    "purchaseDate": {
      "type": "string",
      "format": "date"
    },
    "purchaseCostAmount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "supplierId": {
      "type": [
        "string",
        "null"
      ]
    },
    "usefulLifeYears": {
      "type": [
        "string",
        "integer",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "depreciationRatePercent": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "residualValueAmount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "disposalDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "disposalProceedsAmount": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "isActive": {
      "type": "boolean"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "purchaseCost": {
      "type": "object",
      "properties": {
        "amount": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
        },
        "pence": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)$"
        },
        "isZero": {
          "type": "boolean"
        },
        "isNegative": {
          "type": "boolean"
        }
      },
      "required": [
        "amount",
        "pence",
        "isZero",
        "isNegative"
      ]
    },
    "residualValue": {
      "type": "object",
      "properties": {
        "amount": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
        },
        "pence": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)$"
        },
        "isZero": {
          "type": "boolean"
        },
        "isNegative": {
          "type": "boolean"
        }
      },
      "required": [
        "amount",
        "pence",
        "isZero",
        "isNegative"
      ]
    },
    "disposalProceeds": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "amount": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
        },
        "pence": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)$"
        },
        "isZero": {
          "type": "boolean"
        },
        "isNegative": {
          "type": "boolean"
        }
      },
      "required": [
        "amount",
        "pence",
        "isZero",
        "isNegative"
      ]
    },
    "isDisposed": {
      "type": "boolean"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
