{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:JournalEntry",
  "title": "JournalEntry",
  "description": "Payload of a JournalEntry row.",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "refType": {
      "type": "string"
    },
    "refId": {
      "type": "string"
    },
    "memo": {
      "type": "string"
    },
    "periodId": {
      "type": "string"
    },
    "postedAt": {
      "type": "string",
      "format": "date-time"
    },
    "postedByUserId": {
      "type": "string"
    },
    "registerId": {
      "type": "string"
    },
    "reversesEntryId": {
      "type": [
        "string",
        "null"
      ]
    },
    "reversedByEntryId": {
      "type": [
        "string",
        "null"
      ]
    },
    "isReversed": {
      "type": "boolean"
    },
    "lines": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "journalEntryId": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "accountCode": {
            "type": "string"
          },
          "debit": {
            "type": [
              "string",
              "number"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
          },
          "credit": {
            "type": [
              "string",
              "number"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
          },
          "vatRateId": {
            "type": [
              "string",
              "null"
            ]
          },
          "branchId": {
            "type": "string"
          },
          "registerId": {
            "type": "string"
          },
          "memo": {
            "type": "string"
          },
          "balance": {
            "type": [
              "string",
              "number"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
          },
          "id": {
            "type": "string"
          },
          "companyId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "rowVersion": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          },
          "deletedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "isDeleted": {
            "type": "boolean"
          },
          "domainEvents": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "eventId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "occurredAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "version": {
                  "type": [
                    "string",
                    "integer"
                  ],
                  "pattern": "^-?(?:0|[1-9]\\d*)$"
                }
              },
              "required": [
                "eventId",
                "occurredAt",
                "version"
              ]
            }
          }
        },
        "required": [
          "journalEntryId",
          "accountId",
          "accountCode",
          "debit",
          "credit",
          "vatRateId",
          "branchId",
          "registerId",
          "memo",
          "balance",
          "id",
          "companyId",
          "createdAt",
          "updatedAt",
          "rowVersion",
          "deletedAt",
          "isDeleted",
          "domainEvents"
        ]
      }
    },
    "totalDebits": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "totalCredits": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/properties/lines/items/properties/domainEvents/items"
      }
    }
  },
  "required": [
    "date",
    "refType",
    "refId",
    "memo",
    "periodId",
    "postedAt",
    "postedByUserId",
    "registerId",
    "reversesEntryId",
    "reversedByEntryId",
    "isReversed",
    "lines",
    "totalDebits",
    "totalCredits",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
