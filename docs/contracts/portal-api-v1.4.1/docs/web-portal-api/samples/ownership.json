  "rule": "hub = the portal writes it and every till applies it (conflicts: hub wins). branch = the till\u0027s version always wins; the portal reads it and never writes it. local = never leaves the till. relayed = a branch row the portal copies to the other branch it concerns, which holds it read-only (section 10.2). derivedColumns = worked out from a ledger by each side; never taken as the truth from a push, never written from a pull (section 10.1). hubDrafted = a branch table the portal may also write rows into for one shop, which then owns them (section 10.6).",
  "relayed": {
    "CustomerTransaction": "to every other branch of the business",
    "StockTransfer": "to its toBranchId, once status is dispatched",
    "StockTransferLine": "to the toBranchId of its transfer, with the transfer",
    "StockTransferReceipt": "to the fromBranchId of its transfer",
    "StockTransferReceiptLine": "to the fromBranchId of its transfer, with the receipt"
  },
  "derivedColumns": {
    "Customer": [
      "balance",
      "points"
    ]
  },
  "hubDrafted": {
    "PurchaseOrder": "the portal may draft a head-office order for one shop (origin headOffice; status draft, sent or cancelled) and send it in that shop\u0027s pull; the shop receives against it and owns every change after that (section 10.6)",
    "PurchaseOrderLine": "the lines of a head-office order, with their order; receivedQty is never read from a pull (section 10.6)"
  }
}
