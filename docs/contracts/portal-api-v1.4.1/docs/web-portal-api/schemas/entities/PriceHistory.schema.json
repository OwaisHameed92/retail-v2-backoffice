{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:PriceHistory",
  "title": "PriceHistory",
  "description": "Payload of a PriceHistory row.",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string"
    },
    "branchId": {
      "type": [
        "string",
        "null"
      ]
    },
    "level": {
      "enum": [
        "retail",
        "trade"
      ]
    },
    "oldPrice": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "newPrice": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "oldCost": {
      "type": [
        "string",
        "number",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "newCost": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "userId": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "priceChanged": {
      "type": "boolean"
    },
    "costChanged": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "productId",
    "branchId",
    "level",
    "oldPrice",
    "newPrice",
    "oldCost",
    "newCost",
    "userId",
    "source",
    "reason",
    "at",
    "priceChanged",
    "costChanged",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
