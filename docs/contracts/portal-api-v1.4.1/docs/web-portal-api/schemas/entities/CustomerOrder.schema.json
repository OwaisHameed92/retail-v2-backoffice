{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:CustomerOrder",
  "title": "CustomerOrder",
  "description": "Payload of a CustomerOrder row.",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "customerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "customerName": {
      "type": "string"
    },
    "customerPhone": {
      "type": "string"
    },
    "customerEmail": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ordered",
        "ready",
        "collected",
        "cancelled",
        "expired"
      ]
    },
    "linesJson": {
      "type": "string"
    },
    "goodsTotal": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "paidTotal": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "dueDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "createdByUserId": {
      "type": "string"
    },
    "readyAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "notifiedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "collectedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "saleId": {
      "type": [
        "string",
        "null"
      ]
    },
    "cancelledAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "cancelReasonId": {
      "type": [
        "string",
        "null"
      ]
    },
    "forfeitedAmount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "notes": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "balanceDue": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "isOpen": {
      "type": "boolean"
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "reference",
    "token",
    "customerId",
    "customerName",
    "customerPhone",
    "customerEmail",
    "status",
    "linesJson",
    "goodsTotal",
    "paidTotal",
    "dueDate",
    "expiresAt",
    "createdByUserId",
    "readyAt",
    "notifiedAt",
    "collectedAt",
    "saleId",
    "cancelledAt",
    "cancelReasonId",
    "forfeitedAmount",
    "notes",
    "idempotencyKey",
    "balanceDue",
    "isOpen",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
