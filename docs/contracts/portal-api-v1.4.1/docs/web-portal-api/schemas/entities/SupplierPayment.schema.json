{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:SupplierPayment",
  "title": "SupplierPayment",
  "description": "Payload of a SupplierPayment row.",
  "type": "object",
  "properties": {
    "supplierId": {
      "type": "string"
    },
    "supplierName": {
      "type": "string"
    },
    "paymentDate": {
      "type": "string",
      "format": "date"
    },
    "method": {
      "enum": [
        "bankTransfer",
        "cheque",
        "cash",
        "card",
        "directDebit",
        "other"
      ]
    },
    "reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "amount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "allocatedAmount": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "unallocated": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "isReversed": {
      "type": "boolean"
    },
    "reversedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reversedByUserId": {
      "type": [
        "string",
        "null"
      ]
    },
    "branchId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "supplierId",
    "supplierName",
    "paymentDate",
    "method",
    "reference",
    "amount",
    "allocatedAmount",
    "unallocated",
    "notes",
    "isReversed",
    "reversedAt",
    "reversedByUserId",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
