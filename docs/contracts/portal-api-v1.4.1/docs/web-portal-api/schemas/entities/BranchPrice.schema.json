    },
    "validFromUtc": {
      "type": "string",
      "format": "date-time"
    },
    "validToUtc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "priceIncVat": {
      "type": "object",
      "properties": {
        "amount": {
          "type": [
            "string",
            "number"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
        },
        "pence": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)$"
