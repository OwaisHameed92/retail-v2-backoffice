    "productUnitId",
    "price",
    "validFromUtc",
    "validToUtc",
    "priceIncVat",
    "branchId",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
