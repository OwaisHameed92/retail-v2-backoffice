{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:PaymentType",
  "title": "PaymentType",
  "description": "Payload of a PaymentType row.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "position": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "isCash": {
      "type": "boolean"
    },
    "isCard": {
      "type": "boolean"
    },
    "isVoucher": {
      "type": "boolean"
    },
    "isPoints": {
      "type": "boolean"
    },
    "isAccount": {
      "type": "boolean"
    },
    "isDrsRefund": {
      "type": "boolean"
    },
    "opensDrawer": {
      "type": "boolean"
    },
    "showOnPayment": {
      "type": "boolean"
    },
    "showOnRefund": {
      "type": "boolean"
    },
    "showOnCustomerPayment": {
      "type": "boolean"
    },
    "isActive": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "name",
    "position",
    "isCash",
    "isCard",
    "isVoucher",
    "isPoints",
    "isAccount",
    "isDrsRefund",
    "opensDrawer",
    "showOnPayment",
    "showOnRefund",
    "showOnCustomerPayment",
    "isActive",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
