{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:PromotionRule",
  "title": "PromotionRule",
  "description": "Payload of a PromotionRule row.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "enum": [
        "percentOff",
        "fixedOff",
        "fixedPrice",
        "multiBuy",
        "bogof",
        "mixMatch",
        "mealDeal",
        "quantityPrice",
        "buyGet"
      ]
    },
    "scope": {
      "enum": [
        "product",
        "category",
        "department",
        "itemGroup",
        "customerGroup",
        "branch",
        "basket",
        "style"
      ]
    },
    "targetId": {
      "type": "string"
    },
    "percent": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "amountOff": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "dealPrice": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "memberValue": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$"
    },
    "buyQuantity": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "getQuantity": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "priceTiers": {
      "type": [
        "string",
        "null"
      ]
    },
    "minQuantity": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "priority": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "allowStack": {
      "type": "boolean"
    },
    "isExclusive": {
      "type": "boolean"
    },
    "maxRedemptionsPerSale": {
      "type": [
        "string",
        "integer",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "maxRedemptionsTotal": {
      "type": [
        "string",
        "integer",
        "null"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "redemptionCount": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "couponCode": {
      "type": "string"
    },
    "requiresCoupon": {
      "type": "boolean"
    },
    "branchId": {
      "type": [
        "string",
        "null"
      ]
    },
    "customerGroupId": {
      "type": [
        "string",
        "null"
      ]
    },
    "isHfssSafe": {
      "type": "boolean"
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date"
    },
    "effectiveTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "seasonalEventId": {
      "type": "string"
    },
    "days": {
      "type": "string"
    },
    "timeFrom": {
      "type": [
        "string",
        "null"
      ],
      "format": "time"
    },
    "timeTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "time"
    },
    "isActive": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rowVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "domainEvents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "eventId",
          "occurredAt",
          "version"
        ]
      }
    }
  },
  "required": [
    "name",
    "type",
    "scope",
    "targetId",
    "percent",
    "amountOff",
    "dealPrice",
    "memberValue",
    "buyQuantity",
    "getQuantity",
    "priceTiers",
    "minQuantity",
    "priority",
    "allowStack",
    "isExclusive",
    "maxRedemptionsPerSale",
    "maxRedemptionsTotal",
    "redemptionCount",
    "couponCode",
    "requiresCoupon",
    "branchId",
    "customerGroupId",
    "isHfssSafe",
    "effectiveFrom",
    "effectiveTo",
    "seasonalEventId",
    "days",
    "timeFrom",
    "timeTo",
    "isActive",
    "id",
    "companyId",
    "createdAt",
    "updatedAt",
    "rowVersion",
    "deletedAt",
    "isDeleted",
    "domainEvents"
  ]
}
