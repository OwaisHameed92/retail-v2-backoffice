{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sspos:web-portal-api:v1:pull-reply",
  "title": "pull-reply",
  "description": "GET /api/v1/sync/pull reply: rows after \u0060since\u0060, oldest first.",
  "type": "object",
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "minimum": 0
          },
          "entity": {
            "type": "string"
          },
          "entityId": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "op": {
            "type": "string",
            "enum": [
              "I",
              "U",
              "D"
            ]
          },
          "version": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "minimum": 1
          },
          "companyId": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "branchId": {
            "type": "string",
            "pattern": "^([0-9A-HJKMNP-TV-Z]{26})?$"
          },
          "registerId": {
            "type": "string",
            "pattern": "^([0-9A-HJKMNP-TV-Z]{26})?$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "payload": {
            "type": [
              "object",
              "null"
            ],
            "description": "The whole row; its shape is schemas/entities/\u003Centity\u003E.schema.json."
          },
          "key": {
            "type": "string",
            "description": "Derived: entity:entityId:version. Written by the till, ignored when read."
          }
        },
        "required": [
          "seq",
          "entity",
          "entityId",
          "op",
          "version",
          "companyId",
          "branchId",
          "registerId",
          "at",
          "payload",
          "key"
        ]
      }
    },
    "highestVersion": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "hasMore": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "changes",
    "highestVersion",
    "hasMore"
  ]
}
